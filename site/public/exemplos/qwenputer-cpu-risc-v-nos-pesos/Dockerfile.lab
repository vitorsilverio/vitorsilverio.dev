# Laboratorio do artigo: referencia em Python do Qwenputer x qemu-riscv32 (CPU, sem GPU).
# Debian 12 (bookworm), Python 3.12, qemu-user 7.2. Repositorio fixado no commit conferido.
FROM python:3.12-slim-bookworm
RUN apt-get update -qq && apt-get install -y -qq git qemu-user >/dev/null && rm -rf /var/lib/apt/lists/*
RUN git clone -q https://github.com/divagr18/qwenputer /qwenputer \
 && git -C /qwenputer checkout -q ca13310e2f9f788d1dd3feeea8213c1b0c23913c
RUN pip install -q --no-cache-dir numpy==2.1.3 pytest==8.3.3 safetensors==0.8.0
WORKDIR /qwenputer/experimental/riscv
